# City OS Mobile BFF — example environment.
# Copy to .env (gitignored) and fill in real values.

# --- Keycloak -------------------------------------------------------------
# Server-side base: used for code exchange, refresh and revoke. Never seen by a
# browser, so it may be an internal address.
KEYCLOAK_URL=http://localhost:7080/realms/city-os
KEYCLOAK_CLIENT_ID=city-os-mobile
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://localhost:5173/auth/callback

# password (default): the PWA shows its own form; the BFF signs in against the internal KEYCLOAK_URL.
# pkce: redirect to Keycloak's hosted page (needs a browser-reachable KEYCLOAK_PUBLIC_URL).
AUTH_MODE=password

# Browser-facing base. This stack's realm pins frontendUrl to the Keycloak
# *container* name, and Keycloak renders that origin into the sign-in form's
# action — the browser must be sent to the same origin or the form post arrives
# without the session cookie. Leave empty to use KEYCLOAK_URL.
# See docs/testing.md for the background and the production options.
KEYCLOAK_PUBLIC_URL=http://deploy-keycloak-1:8080/realms/city-os

# --- City Help API (proxied) ---------------------------------------------
CITY_HELP_API_URL=http://localhost:8001

# --- BFF ------------------------------------------------------------------
# Origins allowed to run the OIDC flow (comma separated). Add the tunnel or
# reverse-proxy origin used in the field.
PWA_ORIGINS=http://localhost:5173
# Set to a parent domain when the BFF and the app share one (e.g. .example.com).
# Empty = the request's own hostname.
COOKIE_DOMAIN=

COOKIE_SECURE=false
ACCESS_TOKEN_TTL_MINUTES=5
REFRESH_TOKEN_TTL_HOURS=12

# --- Evidence image storage (City OS object store) -----------------------
# Same credentials City Help uses; uploads land under UPLOADS_PREFIX.
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=city-help
MINIO_SECURE=false
UPLOADS_PREFIX=mobile-attachments
MAX_UPLOAD_BYTES=8388608
# Rate limits per client per minute, for the endpoints reachable without a
# session. Raise them if a large fleet shares one NAT address.
RATE_LIMIT_LOGIN_PER_MINUTE=30
RATE_LIMIT_REFRESH_PER_MINUTE=300
RATE_LIMIT_UPLOAD_PER_MINUTE=120

ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,image/webp,image/heic,image/heif

# Cap on a single proxied call to the City Help API.
PROXY_TIMEOUT_SECONDS=30