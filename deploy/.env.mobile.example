# City OS Mobile: environment template. Key names and SAFE PLACEHOLDERS only.
# Copy to a path OUTSIDE git (e.g. /etc/city-os/mobile.env, chmod 600) and fill in:
#   cp deploy/.env.mobile.example /etc/city-os/mobile.env
#   docker compose -f deploy/docker-compose.mobile.yml --env-file /etc/city-os/mobile.env up -d
# Never commit the filled file. `docker compose config` prints it in full: do not
# paste its output anywhere.

# --- Stack ------------------------------------------------------------------
# Image tag to run (see deploy/build-mobile.sh) and the host port, bound to 127.0.0.1.
MOBILE_TAG=latest
MOBILE_PORT=19447
# Name of an existing docker network for the bff to join so container names
# resolve (e.g. City Help's "deploy_default"). Only read when you also pass
# -f deploy/docker-compose.mobile.upstream.yml; leave empty for host/LAN URLs.
UPSTREAM_NETWORK=

# --- Public address (what the officers type) --------------------------------
# Public https origin(s), comma separated, no trailing slash. Must match the
# address of the TLS proxy exactly. Also used as the CORS / login origin allow list.
PWA_ORIGINS=https://mobile.example.invalid
# Only used when AUTH_MODE=pkce.
KEYCLOAK_REDIRECT_URI=https://mobile.example.invalid/auth/callback
# true whenever users reach the app over https (they must; see README).
COOKIE_SECURE=true
COOKIE_DOMAIN=

# --- Keycloak ---------------------------------------------------------------
# Server-side realm base, reachable FROM the bff container. Never seen by a browser.
KEYCLOAK_URL=http://keycloak.example.invalid:8080/realms/city-os
KEYCLOAK_CLIENT_ID=city-os-mobile
# Leave empty for a public client.
KEYCLOAK_CLIENT_SECRET=
# password (default): the app shows its own sign-in form; no browser redirect to
# Keycloak, so KEYCLOAK_PUBLIC_URL and the old "keycloak alias" are NOT needed.
# pkce: redirects to Keycloak's hosted page; needs a browser-reachable KEYCLOAK_PUBLIC_URL.
AUTH_MODE=password
KEYCLOAK_PUBLIC_URL=
ACCESS_TOKEN_TTL_MINUTES=5
REFRESH_TOKEN_TTL_HOURS=12

# --- City Help API ----------------------------------------------------------
CITY_HELP_API_URL=http://cityhelp.example.invalid:8001
PROXY_TIMEOUT_SECONDS=30

# --- Evidence photos (optional) ---------------------------------------------
# Uploads are disabled unless all three MINIO_* values are set.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=city-help
MINIO_SECURE=false
UPLOADS_PREFIX=mobile-attachments
MAX_UPLOAD_BYTES=8388608

# --- Rate limits (per client per minute) ------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=30
RATE_LIMIT_REFRESH_PER_MINUTE=300
RATE_LIMIT_UPLOAD_PER_MINUTE=120
